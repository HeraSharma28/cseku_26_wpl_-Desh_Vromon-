# Copy this file to ".env" and fill in your real values. Never commit the real .env file to GitHub.

# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/desh_vromon

# MongoDB Atlas (cloud, free tier) - from Atlas "Connect" button:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/desh_vromon

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_secret

PORT=5000
