{
  "name": "desh-vromon-backend",
  "version": "1.0.0",
  "description": "Desh Vromon - Express + MongoDB backend (Week 3-4)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
